{
  "name": "impossible-alarm",
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "private": true,
  "description": "起きられない目覚まし — 朝の自分に、試練を。",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests scripts public/sw.js *.mjs *.mts *.ts *.json *.yaml README.md docs/publish-copy.md",
    "test:secrets": "node scripts/secret-scan.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:secrets && pnpm build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "lucide-react": "1.28.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.25",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
